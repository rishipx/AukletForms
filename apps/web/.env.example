# Copy to .env.local.

# ---- Supabase (browser-safe; access is enforced by Row Level Security) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key (eyJ...) or the newer publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- App URLs ----
# Base URL of your deployed auklet-worker (used in the copy-paste snippets).
NEXT_PUBLIC_INGEST_URL=https://api.auklet.dev
# Public URL of this dashboard. Used for magic-link and billing return URLs; the
# magic-link URL must also be in Supabase > Authentication > Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SERVER-ONLY secrets (never prefix with NEXT_PUBLIC_) ----
# Service-role key: bypasses RLS. Used only by the billing webhook to change plan and quota.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Encrypts each form's Turnstile secret before it is stored. Generate with:  openssl rand -base64 32
# The Cloudflare Worker needs the SAME value (npx wrangler secret put TURNSTILE_ENC_KEY).
TURNSTILE_ENC_KEY=

# Dodo Payments. Keep `test_mode` (the default) until you have deliberately gone live: test keys
# only work with test_mode and live keys only with live_mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=your-dodo-api-key
# Signing key of the webhook endpoint (Dashboard > Developer > Webhooks > your endpoint). Usually starts with whsec_.
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# Product ids (pdt_...) of the two monthly subscription products.
DODO_PRODUCT_PRO=pdt_...
DODO_PRODUCT_AGENCY=pdt_...
